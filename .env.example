# ──────────────────────────────────────────────────────────────────────
# Copia este archivo a `.env` y ajusta los valores.
# Con Docker Compose todo tiene valores por defecto: la app arranca
# sin .env, pero para producción y para Google OAuth necesitas esto.
# ──────────────────────────────────────────────────────────────────────

# ── Base de datos (Docker Compose los usa para crear PostgreSQL) ──
POSTGRES_USER=whitelabel
POSTGRES_PASSWORD=whitelabel
POSTGRES_DB=whitelabel

# Solo para desarrollo local SIN el contenedor de la app (npm run dev):
DATABASE_URL=postgresql://whitelabel:whitelabel@localhost:5432/whitelabel?schema=public

# ── Auth.js ──
# Genera uno propio: openssl rand -base64 32   (ver PASOS-EXTERNOS.md)
AUTH_SECRET=cambia-esto-por-un-secreto-real
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# ── Google OAuth (opcional; ver PASOS-EXTERNOS.md para conseguirlos) ──
# Si quedan vacíos, el botón "Continuar con Google" no se muestra.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ── Usuario administrador (se crea/actualiza en cada arranque) ──
ADMIN_EMAIL=soyadmin@admin.com
ADMIN_PASSWORD=0987654321
ADMIN_NAME=Administrador

# ── Marca (white label) ──
# Nombre inicial de la tienda; luego se edita desde Admin → Configuración
# (el valor de la base de datos tiene prioridad).
APP_NAME=White Label

# ── Imágenes de productos ──
# Carpeta donde se guardan las imágenes subidas por el admin.
# En Docker ya está configurado al volumen /app/uploads.
# UPLOADS_DIR=./uploads

# ── Pagos y emails ──
# Mercado Pago, transferencia y SMTP NO van acá: se cargan desde el panel
# (Admin → Configuración) y quedan guardados en la base de datos.
# Ver PASOS-EXTERNOS.md para conseguir las claves.
